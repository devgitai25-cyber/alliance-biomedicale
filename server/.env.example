# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bioeco?schema=public"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Paymee Payment Gateway (Tunisia)
PAYMEE_API_KEY="your-paymee-api-key"
PAYMEE_SECRET="your-paymee-secret-key"
PAYMEE_WEBHOOK_SECRET="your-paymee-webhook-secret"
PAYMEE_BASE_URL="https://api.paymee.tn" # Or sandbox URL for testing

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Application
APP_PORT=3001
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# CORS
CORS_ORIGINS="http://localhost:3000,https://yourdomain.com"
